# Agent / session state
.remember/
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp

# Logs & temp
*.log
tmp/

# Build
node_modules/
dist/
*.tsbuildinfo

# Vitest browser-mode failure artefacts — regenerated on demand, never committed
__screenshots__/
.vitest-attachments/

# Vite dependency pre-bundling cache
.vite/
node_modules/.vite/

# Production bundle output (built on demand, never committed)
packages/browser/dist/

# Coverage output — a measurement of a moment, regenerated by `npm run test:coverage`.
# The committed record of a measurement is .planning/COVERAGE-BASELINE.md, not this.
coverage/

# Lifted elfconv artifacts — 5.4 MiB each, and 5.4 MiB whether the program does nothing
# or 128 MiB of memory traffic, because the bulk is emulated runtime rather than program.
# `lift.node.test.ts` already refuses to check in a 659 KB binary on the grounds that an
# opaque artifact in the repository is worse than one reproducible from its source; these
# are eight times that. Both regenerate from `tools/aot/fixtures/workload.c` via
# `tools/aot/lift-workload.mjs` in 150-300 s.
tools/aot/fixtures/*-lifted.wasm
tools/aot/fixtures/lifted-*.wasm
# Host-built native binaries — produced by the bench itself from the same source.
tools/aot/fixtures/subject-native
tools/aot/fixtures/workload-native
tools/aot/fixtures/workload-linux

# Agent worktrees. `isolation="worktree"` checks a second copy of the whole repository
# out under here, so an untracked `.claude/` shows up in every `git status` and one
# `git add -A` would commit a duplicate tree. Only `worktrees/` is ignored — if project
# skills or agent definitions are ever added under `.claude/`, they are meant to be
# committed.
.claude/worktrees/
