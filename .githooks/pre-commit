#!/bin/bash
# Pre-commit hook: protected branches, branch naming, and the cheap guards.
#
# **The branch rules moved out on 2026-08-26 and are now in `.githooks/git-flow-rules.sh`.**
# They lived inline here, where nothing could reach them — a hook runs only during a commit,
# so the only way to learn what it accepted was to attempt one. They are exercised directly
# by `packages/node/src/git-flow-rules.node.test.ts` now. This file decides WHICH rule
# applies; the rules themselves, and the reasons for each, live in that script.

BRANCH=$(git rev-parse --abbrev-ref HEAD)
RULES="$(git rev-parse --show-toplevel)/.githooks/git-flow-rules.sh"

# **A conflicted merge is finalised by `git commit`, so it arrives HERE rather than at
# `pre-merge-commit` — and the refusal below used to reject it.** A legitimate
# feature-into-develop merge that happened to touch the same line twice could not be
# committed, while the identical merge without a conflict went through untouched: the same
# act, opposite verdicts, decided by whether two edits collided. When `MERGE_HEAD` exists
# this is a merge, and the merge rule is the one that applies.
if git rev-parse --verify -q MERGE_HEAD >/dev/null 2>&1; then
  if SOURCE=$(bash "$RULES" merge-source); then
    bash "$RULES" check-merge "$BRANCH" "$SOURCE" || exit 1
  else
    echo "⚠️  merge source is not a single local branch — direction not checked" >&2
  fi
else
  # Protected branches - no direct commits allowed
  if [[ $BRANCH =~ ^(main|develop)$ ]]; then
    echo ""
    echo "❌ Direct commits to '$BRANCH' branch are not allowed!"
    echo ""
    echo "Protected branches: main, develop"
    echo ""
    echo "Use git-flow instead:"
    echo ""
    echo "  For new features:"
    echo "    git flow feature start <feature-name>"
    echo "    # Make changes..."
    echo "    git flow feature finish <feature-name>"
    echo ""
    echo "  For releases:"
    echo "    git flow release start <version>"
    echo "    # Prepare release..."
    echo "    git flow release finish <version>"
    echo ""
    echo "  For hotfixes:"
    echo "    git flow hotfix start <version>"
    echo "    # Fix issue..."
    echo "    git flow hotfix finish <version>"
    echo ""
    echo "Or manually switch to a feature branch:"
    echo "  git checkout develop"
    echo "  git checkout -b feature/<feature-name>"
    echo ""
    exit 1
  fi

  # A REFUSAL since 2026-08-26, and a warning before it. See `git-flow-rules.sh` for the
  # measurement that changed it: the warning let 44 of 108 branches through.
  bash "$RULES" check-name "$BRANCH" || exit 1
fi

# ---------------------------------------------------------------------------
# The cheap guards, run against what is about to be committed
# ---------------------------------------------------------------------------
#
# Added 2026-08-01. Until now this hook enforced branch naming and nothing else:
# no test, no `tsc`, no guard ran before a commit anywhere in this repository.
#
# WHY THIS IS A HOOK **AND ALSO CI** — corrected 2026-08-27.
#
# This paragraph read *"it must stay local… `disclosure-gate.node.test.ts` asserts that
# `.github/workflows` does not exist… Do not 'fix' the absence of `.github/` by adding
# it."* That was true when written and is now false in its premise: the disclosure gate
# no longer forbids workflows. Its rule was ABSENCE, which was a proxy; it is now the
# claim itself — no money-spending workflow may fire on a push, a PR or a schedule, and a
# deploying one must be triggered by a release or by hand. CI exists and runs these same
# guards through `scripts/cheap-guards.sh`.
#
# What survives unchanged is why the hook is still worth having: it runs BEFORE the push,
# so a violation never reaches the remote at all.
#
# WHY PRE-COMMIT AND NOT PRE-PUSH. `vocabulary.node.test.ts` and
# `disclosure-gate.node.test.ts` build their corpus from `git ls-files`, i.e. the
# index. A guard run *before* `git add` cannot see the file it is about to judge,
# and that has already produced a defect: a verification pass reported its guards
# green from a run that could not have read the file it was about to write. By the
# time this hook runs, `git add` has happened, so the file is in the index and
# inside the guards' jurisdiction.
#
# WHAT THIS STILL DOES NOT CATCH, stated rather than left to be discovered. The
# guards list files from the index but read their *contents* from the working tree.
# A partially-staged file is therefore judged in its working-tree form, which is not
# what the commit will contain. `git commit -a` and a fully-staged tree are exact;
# `git add -p` is not.
#
# Deliberately not run here: `tsc --noEmit` (~10 s) and the full node suite
# (~290 s). A hook slow enough to be resented is a hook that gets disabled with
# `--no-verify`, and then it guards nothing at all.
#
# ## What the reachability guard costs, as a COMPARATIVE reading rather than a claim
#
# Added 2026-08-08 by Plan 22-04. Measured in one run window, `/usr/bin/time -p`:
#
#   six guards        real 2.96 and 3.13   user+sys 3.20 and 3.42   241 tests
#   plus reachability real 3.40            user+sys 5.97            261 tests
#
# **+12% wall clock, +80% CPU.** The two numbers disagree on purpose and the reason is
# the reading: the TypeScript API this guard drives runs in a SEPARATE process, so its
# work lands in `user` while the wall clock overlaps it. Wall clock is what a committer
# waits for and is the number that decides whether this hook survives.
#
# **The value that would break it: if the seven-guard arm ever reads more than twice the
# six-guard arm in the same window, take it out of the hook** and run it in the phase
# gate instead. It is at 1.12x today. An absolute threshold is not used here, for the
# reason CLAUDE.md § Measurement gives — it would encode this machine and this day.
#
# ## IT IS IN THIS HOOK **AND** IN CI — corrected 2026-08-27
#
# This read *"there is no CI and there must not be one… this hook is the only gate this
# repository has."* Both halves are now false. CI runs `scripts/cheap-guards.sh`, the same
# seven specs this hook runs, from the same list.
#
# **And the correction is not cosmetic — the gap it names was real and lasted a day.** CI's
# node lane was narrowed to `O2_UNIT_ONLY=1`, which excludes specs above `SLOW_CUTOFF_MS`,
# and three guards are above it: `vocabulary`, `disclosure-gate` and `reachability-guard`.
# For one day CI ran four of the seven and nothing said so.

if [ "$O2_SKIP_GUARDS" = "1" ]; then
  echo "⏭️  O2_SKIP_GUARDS=1 — skipping the cheap guards"
  exit 0
fi

REPO_ROOT=$(git rev-parse --show-toplevel)

# A worktree that was never installed into has no runner. Skip loudly rather than
# failing the commit: this repository's own workflow creates worktrees per agent,
# and a hook that blocks every commit in a fresh one would be removed within a day.
if [ ! -x "$REPO_ROOT/node_modules/.bin/vitest" ]; then
  echo "⏭️  no node_modules/.bin/vitest in $REPO_ROOT — skipping the cheap guards"
  echo "   (run 'npm install' to enable them)"
  exit 0
fi

# Run whenever anything is staged. `--diff-filter=ACMR` leaves out deletions, whose
# content cannot be scanned.
#
# ## This used to filter, and the filter was a hole
#
# It read:
#
#     RELEVANT=$(printf '%s\n' "$STAGED" | grep -E '(\.ts$|^\.planning/.*\.md$|^\.github/)')
#
# — on the reasoning that the guards are "only worth running when something they read
# is staged." But that reasoning is false about these guards specifically: as the
# comment above records, `vocabulary` and `disclosure-gate` build their corpus from
# `git ls-files`, i.e. **every tracked file**. So the population a guard *checks* was
# strictly larger than the population that *triggered* it, and the gap was exploitable
# by accident.
#
# Measured, 2026-08-03: a banned term was committed into `CLAUDE.md` — a root-level
# `.md`, matching none of those three patterns — and the commit sailed through with no
# guard run at all. It then refused **every subsequent commit** by an agent working on
# `.ts` files, who had to reach for `O2_SKIP_GUARDS=1` to land work that was not the
# cause. The author of a violation was the one person the guard could not stop, and the
# cost fell on somebody else.
#
# This is the same shape as the ledger-guard defect found in Phase 18, where rows moved
# out of the checked population the moment they were edited: **the act of touching a
# thing exempted it.** Whenever a guard's corpus and its trigger are written in two
# places, they drift, and the drift always favours the writer.
#
# The cost of not filtering is one vitest process — well under a second, and it is
# already paid on every `.ts` commit, which is nearly all of them.
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$STAGED" ]; then
  exit 0
fi

# ---------------------------------------------------------------------------
# Whose commit is this — the answer, handed to the guards
# ---------------------------------------------------------------------------
#
# The corpus a guard scans is the whole repository; the commit is a handful of paths.
# So until now one agent's in-flight edit was a commit outage for every other agent:
# the concurrent writer was refused, the author of the violation was not, and the only
# way out was `O2_SKIP_GUARDS=1`. Measured 2026-08-04, `git log --all
# --grep=O2_SKIP_GUARDS` returns 18. `7717ade` records the canonical instance.
#
# `STAGED` above was already computed and was used for nothing but "is anything
# staged"; the list itself never reached a guard. It does now.
#
# ## The list goes through a FILE. Never an environment variable. ##
#
# This is the most dangerous available "simplification" in this hook, so it is stated
# where somebody would make it. Measured on this machine's `/bin/bash` 3.2.57 — which
# is this file's shebang:
#
#     printf 'a.ts\0b.ts\0' > list; V=$(cat list); echo "${#V}"   ->   8
#
# Command substitution drops the NUL bytes SILENTLY and yields the single path
# `a.tsb.ts`. Every finding would then match nothing, read as somebody else's, and the
# guards would block on nothing at all — a bypass with no symptom, applied to every
# commit. A file carries the NULs; `$( )` does not.
#
# `--diff-filter=ACMRD`, not `ACMR`: measured on git 2.33.0, `ACMR` omits deletions,
# and a deletion is a violation *cause* — delete a file a ledger entry names and that
# entry breaks. `--no-renames`: with rename detection on git prints only the
# destination, so a finding keyed on the old path would read as foreign. `-z`: without
# it an odd path is C-quoted and matches nothing. `--no-relative`: `diff.relative` in
# somebody's config would otherwise make these paths relative to the cwd, and every
# guard emits repo-relative.
#
# The empty tree is the base on the initial commit, where `git rev-parse --verify HEAD`
# fails. An unreadable, empty or malformed file means NO_COMMIT_SCOPE on the reading
# side, under which every guard blocks on everything — so no failure here can widen
# what a guard tolerates.
SCOPE_FILE=$(mktemp "${TMPDIR:-/tmp}/o2-commit-scope.XXXXXX")
trap 'rm -f "$SCOPE_FILE"' EXIT

BASE=$(git rev-parse --verify --quiet HEAD)
if [ -z "$BASE" ]; then
  BASE=$(git hash-object -t tree /dev/null)
fi

git diff-index --cached --name-only --no-relative --no-renames --diff-filter=ACMRD -z \
  "$BASE" > "$SCOPE_FILE"
export O2_COMMIT_PATHS_FILE="$SCOPE_FILE"

# **The list moved to `scripts/cheap-guards.sh` on 2026-08-27, and the move is a fix.**
#
# It lived here, spelled out, and nowhere else — so when CI's node lane was narrowed to
# `O2_UNIT_ONLY=1` that same day it silently dropped THREE of the seven, `vocabulary`,
# `disclosure-gate` and `reachability-guard`, all of which cost more than `SLOW_CUTOFF_MS`.
# The guard that keeps a paid deploy from happening by itself was not running in the very
# lane whose existence it had just been rewritten to permit.
#
# One definition, two readers. `slow-specs.node.test.ts` asserts that this hook names the
# script, that CI names it, and that this hook spells out NO spec path of its own — so the
# list cannot quietly grow a second copy here again.
bash "$REPO_ROOT/scripts/cheap-guards.sh"
GUARD_STATUS=$?

if [ "$GUARD_STATUS" -ne 0 ]; then
  echo ""
  echo "❌ a cheap guard failed — commit refused"
  echo ""
  echo "These are the guards that are fast enough to run every time. A failure here"
  echo "is a real finding about the staged tree, not flake."
  echo ""
  echo "To commit anyway (and you should have a reason):"
  echo "  O2_SKIP_GUARDS=1 git commit …"
  echo ""
  exit 1
fi

echo "✅ cheap guards passed"

# Allow commit to proceed
exit 0
