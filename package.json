{
  "name": "o2-services",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "aot:lift": "node --experimental-strip-types tools/aot/cli.ts",
    "build:demo": "vite build --config packages/browser/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "O2_UNIT_ONLY=1 vitest run --project node --project aot",
    "test:node": "vitest run --project node",
    "test:aot": "vitest run --project aot",
    "test:node-lanes": "vitest run --project node && vitest run --project aot",
    "test:browser": "vitest run --project browser",
    "test:e2e": "vitest run --project e2e",
    "test:coverage": "vitest run --project node --coverage",
    "test:perf": "O2_PERF=1 vitest run --project perf",
    "test:mutations": "node --experimental-strip-types packages/node/src/mutation-guard.mutate.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "playwright": "^1.62.0",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wabt": "^1.0.39"
  },
  "overrides": {
    "multiformats": "14.0.5",
    "uint8arrays": "6.1.1"
  }
}
